<?xml version="1.0" encoding="UTF-8" ?>
<!-- Base project: Create.bat auto-appends one Ultra/100 procedure per exported
     function at build time (VMPProcedures.ps1). EntryPoint keyword stays. -->
<Document Version="2">
    <Protection InputFileName="Ameger Injector - x64.dll" Options="327680" VMCodeSectionName=".???" VMComplexity="100" VMInstances="10">
        <Messages />
        <Folders />
        <Procedures>
            <Procedure MapAddress="EntryPoint" Options="0" CompilationType="2" Complexity="100" />
        </Procedures>
        <Objects />
    </Protection>
    <DLLBox>
        <Folders />
    </DLLBox>
    <Script />
    <LicenseManager />
</Document>
